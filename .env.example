# PostgreSQL
DOVE_DATABASE_URL=jdbc:postgresql://localhost:5432/dove
DOVE_DATABASE_USERNAME=dove
DOVE_DATABASE_PASSWORD=change-me

# Keycloak Sonatel — remplacer par les valeurs de l'environnement
DOVE_KEYCLOAK_ISSUER_URI=https://sso.example.sonatel.sn/realms/sonatel
DOVE_KEYCLOAK_AUDIENCE=dove-api
DOVE_KEYCLOAK_WEB_CLIENT_ID=dove-web
DOVE_ALLOWED_ORIGINS=https://dove.example.sonatel.sn

# Passerelle de stockage objet Sonatel
DOVE_STORAGE_PROVIDER=gateway
DOVE_STORAGE_GATEWAY_URL=https://storage-gateway.example.internal
DOVE_STORAGE_GATEWAY_API_KEY=change-me
DOVE_STORAGE_MAX_UPLOAD_BYTES=536870912
